{
  "expo": {
    "name": "FoodPassApp",
    "slug": "FoodPassApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/foodpass_logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodpass.app"
    },
    "android": {
      "package": "com.foodpass.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/foodpass_logo.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/foodpass_logo.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/foodpass_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
